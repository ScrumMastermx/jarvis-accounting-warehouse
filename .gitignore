# Datos reales del negocio: NUNCA se suben. Solo se conserva datos/README.md.
datos/*
!datos/README.md
!datos/.gitkeep

# Reportes generados: llevan RFC, nombres y cifras reales dentro del xlsx (binario, el scrub no lo ve). Solo local.
reportes/*
!reportes/.gitkeep
.env
*.env
__pycache__/
.venv/
*.xlsx~
~$*.xlsx
.DS_Store

# Preescolar: registros con nombres de menores. Solo local. (datos/escuela/ ya queda bajo datos/*)
programas/alumnos/*
!programas/alumnos/.gitkeep
